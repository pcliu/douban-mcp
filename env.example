# 豆瓣 MCP 服务器环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置值

# =============================================================================
# 数据库配置
# =============================================================================
# SQLite 数据库文件路径
CACHE_DB_PATH=./data/cache.db

# =============================================================================
# 浏览器基础配置
# =============================================================================
# 是否使用无头模式 (True/False)
BROWSER_HEADLESS=True

# 浏览器超时时间 (毫秒)
BROWSER_TIMEOUT=30000

# 用户代理字符串
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# 【新增】是否加载图片 (True/False) - 可影响性能和抓取效果
BROWSER_LOAD_IMAGES=True

# 【新增】浏览器视口宽度 (像素) - 影响页面渲染和居中效果
BROWSER_VIEWPORT_WIDTH=1366

# 【新增】浏览器视口高度 (像素) - 影响页面渲染效果
BROWSER_VIEWPORT_HEIGHT=768

# 【新增】是否将浏览器窗口居中 (True/False) - 仅在非headless模式下有效
BROWSER_CENTER_WINDOW=True

# =============================================================================
# 浏览器模式配置
# =============================================================================
# 浏览器模式: "local" 或 "remote"
BROWSER_MODE=local

# =============================================================================
# 本地浏览器配置 (当 BROWSER_MODE=local 时使用)
# =============================================================================
# 自定义浏览器可执行文件路径 (可选)
# LOCAL_BROWSER_EXECUTABLE_PATH=/path/to/chrome

# 额外的浏览器启动参数 (JSON数组格式，可选)
# LOCAL_BROWSER_ARGS=["--disable-web-security", "--allow-running-insecure-content"]

# =============================================================================
# 远程浏览器配置 (当 BROWSER_MODE=remote 时使用)
# =============================================================================
# 远程浏览器 WebSocket URL (如 Browserless, ScrapeOwl 等)
# REMOTE_BROWSER_URL=wss://your-browserless-instance.com

# 远程浏览器 API 密钥 (可选)
# REMOTE_BROWSER_API_KEY=your-api-key

# 远程浏览器访问令牌 (可选)
# REMOTE_BROWSER_TOKEN=your-token

# =============================================================================
# 抓取行为配置
# =============================================================================
# 最小请求延迟 (秒)
REQUEST_DELAY_MIN=1.0

# 最大请求延迟 (秒)
REQUEST_DELAY_MAX=3.0

# 最大并发请求数
MAX_CONCURRENT_REQUESTS=5

# 最大重试次数
MAX_RETRIES=3

# =============================================================================
# 缓存配置
# =============================================================================
# 缓存生存时间 (秒)
CACHE_TTL=3600

# 缓存键前缀
CACHE_KEY_PREFIX=douban_mcp:

# =============================================================================
# MCP 服务器配置
# =============================================================================
# MCP 服务器名称
MCP_SERVER_NAME=douban-mcp

# MCP 服务器版本
MCP_SERVER_VERSION=0.1.0

# =============================================================================
# 日志配置
# =============================================================================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志格式
LOG_FORMAT={time} | {level} | {name}:{function}:{line} - {message}

# =============================================================================
# 配置说明
# =============================================================================
# 
# 新增配置项说明:
# 
# 1. BROWSER_LOAD_IMAGES: 控制是否加载图片
#    - True: 加载图片 (完整渲染，适合需要图片信息的抓取)
#    - False: 跳过图片 (更快速度，适合纯文本抓取)
#
# 2. BROWSER_VIEWPORT_WIDTH/HEIGHT: 控制浏览器视口尺寸
#    - 1366x768: 标准笔记本分辨率 (推荐，当前默认)
#    - 1920x1080: 高分辨率显示器
#    - 1280x720: 较小屏幕
#    - 自定义尺寸: 根据目标网站优化
#
# 3. BROWSER_CENTER_WINDOW: 控制浏览器窗口位置
#    - True: 自动计算屏幕中心位置启动浏览器 (推荐)
#    - False: 使用默认位置 (100,100)
#
# 性能建议:
# - 开发测试时: BROWSER_HEADLESS=False, BROWSER_LOAD_IMAGES=True
# - 生产环境: BROWSER_HEADLESS=True, BROWSER_LOAD_IMAGES=False
# - 需要截图: BROWSER_LOAD_IMAGES=True
#
# 使用方法:
# 1. 复制此文件为 .env: cp env.example .env
# 2. 根据需要修改 .env 文件中的配置值
# 3. 重启应用程序以使配置生效 